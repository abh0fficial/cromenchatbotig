# Copy to .env.local and fill in. Never commit .env.local.

# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Instagram / Meta — User access token with instagram_business_manage_messages
INSTAGRAM_ACCESS_TOKEN=
# Any string you choose; paste the same value into the Meta webhook setup
INSTAGRAM_VERIFY_TOKEN=

# AI — Google Gemini (primary). https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# AI — OpenRouter (automatic fallback). https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional. Tried first, then the built-in cascade in src/lib/ai.ts
AI_MODEL=google/gemma-4-26b-a4b-it:free
