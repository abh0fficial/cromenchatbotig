# Copy to .env.local and fill in. Never commit .env.local.

# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Instagram / Meta — User access token with instagram_business_manage_messages
INSTAGRAM_ACCESS_TOKEN=
# Any string you choose; paste the same value into the Meta webhook setup
INSTAGRAM_VERIFY_TOKEN=

# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional. Tried first, then the built-in cascade in src/lib/ai.ts
AI_MODEL=google/gemini-2.0-flash-exp:free
